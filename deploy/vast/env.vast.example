# Image/model selection
HIDREAM_WORKFLOW=sdxl_janku
HIDREAM_MODEL_REPO=HiDream-ai/HiDream-O1-Image-Dev
HIDREAM_MODEL_PATH=/models/HiDream-O1-Image-Dev
HIDREAM_MODEL_TYPE=dev
HIDREAM_TORCH_DTYPE=auto

# SDXL/JANKU workflow
JANKU_MODEL_PATH=/models/checkpoints/janku-v6.safetensors
JANKU_MODEL_URL=
JANKU_R2_BUCKET=
JANKU_R2_KEY=models/jankuV60.safetensors
SDXL_DOWNLOAD_ON_START=1
SDXL_DOWNLOAD_WAIT_SECONDS=7200
JANKU_STEPS=28
JANKU_CFG_SCALE=5
QWEN_IMAGE_EDIT_MODEL_REPO=Qwen/Qwen-Image-Edit-2511
QWEN_IMAGE_EDIT_DOWNLOAD_ON_START=1
QWEN_IMAGE_EDIT_STEPS=40
QWEN_IMAGE_EDIT_TRUE_CFG_SCALE=4.0
QWEN_IMAGE_EDIT_GUIDANCE_SCALE=1.0
QWEN_IMAGE_EDIT_NEGATIVE_PROMPT= 
SDXL_NEGATIVE_PROMPT=lowres, worst quality, low quality, bad anatomy, bad hands, extra fingers, missing fingers, blurry, jpeg artifacts, watermark, signature, text
CIVITAI_TOKEN=

# HiDream I1/E1.1 workflow
HIDREAM_I1_MODEL_REPO=HiDream-ai/HiDream-I1-Dev
HIDREAM_I1_LLM_REPO=meta-llama/Meta-Llama-3.1-8B-Instruct
HIDREAM_I1_STEPS=28
HIDREAM_I1_GUIDANCE_SCALE=0
HIDREAM_E11_BASE_REPO=HiDream-ai/HiDream-I1-Full
HIDREAM_E11_MODEL_REPO=HiDream-ai/HiDream-E1-1
HIDREAM_E11_LLM_REPO=meta-llama/Meta-Llama-3.1-8B-Instruct
HIDREAM_E11_STEPS=28
HIDREAM_E11_GUIDANCE_SCALE=3
HIDREAM_E11_IMAGE_GUIDANCE_SCALE=1.5
HIDREAM_E11_REFINE_STRENGTH=0.3

# Server
HIDREAM_HOST=0.0.0.0
HIDREAM_PORT=7861
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# Prompt refinement
AUTO_PROMPT_OPTIMIZE=1
PROMPT_OPTIMIZER_BACKEND=local
HIDREAM_AGENT_MODEL=Qwen/Qwen3.5-9B
HIDREAM_AGENT_DEVICE=cpu
HIDREAM_AGENT_MAX_NEW_TOKENS=1400
HIDREAM_AGENT_TEMPERATURE=0
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=google/gemma-4-31b-it:free
OPENAI_API_KEY=replace-with-openrouter-key

# Optional local fallback if you run Ollama on the Vast host
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:9b

# Cloudflare R2 storage
R2_BUCKET=hidream-o1-generated-images
R2_ENDPOINT_URL=https://6928e8e09e663e95ad8765360633b3f8.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-with-r2-access-key
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-key
