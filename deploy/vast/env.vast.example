# Application
APP_HOST=0.0.0.0
APP_PORT=7861
# Set this before production. The Cloudflare Worker sends the same value in
# X-Backend-Key; keep it out of GitHub and generate a long random value.
BACKEND_SHARED_SECRET=
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
MODEL_TORCH_DTYPE=auto
LORA_ROOT=/models/loras

# The published image is intentionally lightweight. PyTorch CUDA and the Python
# packages are installed once on a fresh Vast.ai disk before the web app starts.
RUNTIME_SETUP_ON_START=1
PYTORCH_INDEX_URL=https://download.pytorch.org/whl/cu128
PYTORCH_VERSION=2.7.1
TORCHVISION_VERSION=0.22.1

# Local and Vast use the same LoRA-training base. LoRAs are only compatible
# with the exact IMAGE_MODEL_PROFILE on which they were trained.
IMAGE_MODEL_FAMILY=animagine
IMAGE_MODEL_PROFILE=sdxl-animagine-zero
ANIMAGINE_MODEL_REPO=cagliostrolab/animagine-xl-4.0-zero
ANIMAGINE_MODEL_CONFIG=cagliostrolab/animagine-xl-4.0-zero
ANIMAGINE_MODEL_FILE=animagine-xl-4.0-zero.safetensors
ANIMAGINE_MODEL_PATH=/models/checkpoints/animagine-xl-4.0-zero.safetensors
ANIMAGINE_MODEL_MIN_BYTES=6900000000

# Optional JANKU v7.77 fallback. Set IMAGE_MODEL_FAMILY=janku and
# IMAGE_MODEL_PROFILE=sdxl-janku-v777 before using these values.
JANKU_MODEL_PATH=/models/checkpoints/JANKUTrainedChenkinNoobai_v777.safetensors
JANKU_MODEL_MIN_BYTES=6900000000
JANKU_R2_BUCKET=ai-model-cache
JANKU_R2_KEY=models/JANKUTrainedChenkinNoobai_v777.safetensors
MODEL_DOWNLOAD_ON_START=1
MODEL_DOWNLOAD_WAIT_SECONDS=7200

# Character-reference adapter and optional image editors from Hugging Face
IP_ADAPTER_MODEL=h94/IP-Adapter
IP_ADAPTER_SUBFOLDER=sdxl_models
IP_ADAPTER_WEIGHT_NAME=ip-adapter-plus_sdxl_vit-h.safetensors
IP_ADAPTER_IMAGE_ENCODER_FOLDER=models/image_encoder
IP_ADAPTER_DEFAULT_SCALE=0.25
IP_ADAPTER_CHARACTER_CROP=1
IP_ADAPTER_DOWNLOAD_ON_START=1

# Automatic silhouette masking is not part of the default workflow. Waifu is
# retained only for explicit user-provided local masks; FLUX and HiDream are lazy.
WAIFU_INPAINT_MODEL=ShinoharaHare/Waifu-Inpaint-XL
WAIFU_INPAINT_DOWNLOAD_ON_START=0
WAIFU_INPAINT_STEPS=28
WAIFU_INPAINT_CFG=5.0
WAIFU_INPAINT_UNMASKED_STRENGTH=0.55
WAIFU_INPAINT_MASKED_STRENGTH=0.85
WAIFU_INPAINT_BACKGROUND_STRENGTH=1.0
ANIME_SEGMENTATION_DOWNLOAD_ON_START=0
FLUX_KONTEXT_MODEL=black-forest-labs/FLUX.1-Kontext-dev
FLUX_KONTEXT_STEPS=28
FLUX_KONTEXT_GUIDANCE=2.5
HIDREAM_O1_IMAGE_MODEL=HiDream-ai/HiDream-O1-Image
HIDREAM_O1_IMAGE_PATH=/models/HiDream-O1-Image

# Local Japanese-to-English prompt refinement
PROMPT_REFINE_DEFAULT=1
PROMPT_REFINER_MODEL=Qwen/Qwen3.5-9B
PROMPT_REFINER_DEVICE=cuda
PROMPT_REFINER_MAX_NEW_TOKENS=96
PROMPT_REFINER_MAX_TIME=90
PROMPT_REFINER_USE_KERNELS=0
PROMPT_REFINER_DOWNLOAD_ON_START=1
PROMPT_REFINER_LOCAL_FILES_ONLY=1

# Optional Hugging Face token for higher download limits
HF_TOKEN=

# R2 credentials shared by model download and generated-image storage
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<r2-access-key>
R2_SECRET_ACCESS_KEY=<r2-secret-key>
R2_BUCKET=hidream-o1-generated-images
