name = "janku-image-studio"
main = "src/index.ts"
compatibility_date = "2026-07-01"

[[r2_buckets]]
binding = "GALLERY_BUCKET"
bucket_name = "hidream-o1-generated-images"

[[d1_databases]]
binding = "DB"
database_name = "janku-image-studio"
database_id = "replace-with-d1-database-id"
migrations_table = "d1_migrations"
migrations_dir = "migrations"

[vars]
# Leave empty until the public Vast.ai URL is known.
BACKEND_URL = ""
ALLOWED_ORIGIN = "https://your-worker.example.workers.dev"
# Required before enabling public access. These values are shown by Access.
ACCESS_TEAM_DOMAIN = "https://your-team.cloudflareaccess.com"
ACCESS_AUD = "replace-with-access-application-audience"

# BACKEND_SHARED_SECRET must be stored as a Worker secret, not in this file.
