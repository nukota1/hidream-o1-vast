FROM python:3.10-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HF_HOME=/models/huggingface \
    APP_HOST=0.0.0.0 \
    APP_PORT=7861 \
    MODEL_TORCH_DTYPE=auto

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        git \
        libglib2.0-0 \
        libgl1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/janku-image-studio

COPY . /workspace/janku-image-studio
# The repository is also edited from Windows. Normalize the shell script here
# so both local Docker and Vast.ai always receive a Linux executable.
RUN sed -i 's/\r$//' /workspace/janku-image-studio/deploy/vast/entrypoint.sh \
    && chmod +x /workspace/janku-image-studio/deploy/vast/entrypoint.sh

EXPOSE 7861
CMD ["/workspace/janku-image-studio/deploy/vast/entrypoint.sh"]
