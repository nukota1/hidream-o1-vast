# Vast.ai pre-caches this base image on host machines. Keeping our own layer
# limited to application source avoids long registry downloads during rental.
FROM vastai/base-image:cuda-12.8.1-cudnn-devel-ubuntu22.04-py310

ENV HF_HOME=/models/huggingface \
    APP_HOST=0.0.0.0 \
    APP_PORT=7861 \
    MODEL_TORCH_DTYPE=auto

# The Vast base image copies this directory to /workspace on first boot.
COPY . /opt/workspace-internal/janku-image-studio
COPY deploy/vast/janku-image-studio.conf /etc/supervisor/conf.d/janku-image-studio.conf
COPY deploy/vast/run-janku-image-studio.sh /opt/supervisor-scripts/janku-image-studio.sh

RUN dos2unix /opt/workspace-internal/janku-image-studio/deploy/vast/entrypoint.sh \
    /opt/supervisor-scripts/janku-image-studio.sh \
    && chmod +x /opt/workspace-internal/janku-image-studio/deploy/vast/entrypoint.sh \
    /opt/supervisor-scripts/janku-image-studio.sh

EXPOSE 7861
