# Shared secrets for local Docker and Vast.ai.
# Copy this file to .env and replace every placeholder. Do not commit .env.

# Private Cloudflare R2 access for the JANKU model cache and generated images.
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<r2-access-key>
R2_SECRET_ACCESS_KEY=<r2-secret-key>
R2_BUCKET=hidream-o1-generated-images

# Optional: required only when Hugging Face download limits require authentication.
HF_TOKEN=
